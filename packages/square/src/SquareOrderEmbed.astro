---
// @ngc/square/SquareOrderEmbed
//
// Renders Square Online's order surface for pickup/delivery.
//
// Behavior:
// - If `siteUrl` is provided (or PUBLIC_SQUARE_SITE_URL env is set), embed the
//   Square Online site as an iframe.
// - Otherwise render a "coming soon" panel — useful for pre-launch staging
//   before the Square account is provisioned.
//
// Square Online provides a per-merchant subdomain (e.g. https://kingdomdeli.square.site).
// The order page is typically at `<subdomain>/order` or just the root.

interface Props {
  /** Full Square Online site URL, e.g. https://kingdomdeli.square.site */
  siteUrl?: string;
  /** Path to append for the order surface. Defaults to '/order'. */
  orderPath?: string;
  /** Square location ID — kept for future API use; not required for the iframe embed. */
  locationId?: string;
  mode?: 'pickup' | 'delivery';
  /** Copy shown when no siteUrl is configured. */
  comingSoonMessage?: string;
  /** Optional opening date shown on the placeholder. */
  comingSoonDate?: string;
  /** Optional iframe height. */
  height?: number;
}

const {
  siteUrl = import.meta.env.PUBLIC_SQUARE_SITE_URL,
  orderPath = '/order',
  comingSoonMessage = 'Online ordering opens soon. For now, come see us at the counter.',
  comingSoonDate,
  height = 900,
} = Astro.props;

const hasSite = Boolean(siteUrl);
const orderUrl = hasSite ? `${siteUrl}${orderPath}` : null;
---

{hasSite && orderUrl ? (
  <div class="square-order-embed">
    <iframe
      src={orderUrl}
      title="Order online"
      width="100%"
      height={height}
      loading="lazy"
      allow="payment"
    ></iframe>
    <p class="square-order-fallback">
      Trouble loading the menu? <a href={orderUrl} target="_blank" rel="noopener">Open Square Online directly</a>.
    </p>
  </div>
) : (
  <div class="square-coming-soon">
    <p class="coming-soon-message">{comingSoonMessage}</p>
    {comingSoonDate && <p class="coming-soon-date">Opens {comingSoonDate}</p>}
  </div>
)}

<style>
  .square-order-embed {
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
  }
  .square-order-embed iframe {
    width: 100%;
    border: 0;
    background: var(--color-bg);
  }
  .square-order-fallback {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    text-align: center;
    margin: var(--space-3) 0 0;
  }
  .square-coming-soon {
    max-width: 36rem;
    margin: var(--space-12) auto;
    padding: var(--space-12) var(--space-6);
    text-align: center;
    border: var(--border-heavy);
    background: var(--color-surface);
  }
  .coming-soon-message {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    margin: 0 0 var(--space-3);
    color: var(--color-text);
  }
  .coming-soon-date {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
