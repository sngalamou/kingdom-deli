---
// @ngc/ui/components/MenuItem — shared, app-agnostic. NO cart import (package boundary).
// The "+" button carries data-* attributes; the consuming app's cart.ts wires the
// click + repaints it into a cart icon with a count via initAddButtons().
interface MenuItemImage { asset?: unknown; alt?: string; url?: string; }
interface MenuItemData {
  name: string;
  description?: string;
  price?: number;
  image?: MenuItemImage;
  category?: string;
  Desert?: boolean;
  variationId?: string;   // Square variation ID; presence enables the + button
}
interface Props { item: MenuItemData; }
const { item } = Astro.props;
const hasImage = !!item.image?.url;
const variantClass = [
  'menu-item',
  item.category ? `menu-item--${item.category.toLowerCase()}` : null,
  item.Desert ? 'menu-item--desert' : null,
].filter(Boolean).join(' ');
---
<article class={variantClass}>
  <div class="menu-item-image">
    {hasImage
      ? <img src={item.image?.url} alt={item.image?.alt ?? item.name} loading="lazy" />
      : <div class="image-placeholder" aria-hidden="true" />}
  </div>
  <div class="menu-item-body">
    <header class="menu-item-header">
      <h3 class="menu-item-name">{item.name}</h3>
      {item.price && <span class="menu-item-price">${item.price.toFixed(2)}</span>}
    </header>
    {item.description && <p class="menu-item-description">{item.description}</p>}
    <div class="flex gap-2 mt-3 items-center">
      <slot name="badge" />
      {item.variationId && (
        <button
          type="button"
          class="add-btn"
          data-add-to-cart
          data-variation-id={item.variationId}
          data-label={item.name}
          aria-label={`Add ${item.name} to order`}
        ><span class="add-btn__plus" aria-hidden="true">+</span></button>
      )}
    </div>
  </div>
</article>

<style>
  .menu-item { background: var(--color-surface); border: 1px solid var(--color-border, var(--color-charcoal-700)); border-radius: 4px; overflow: hidden; display: flex; flex-direction: column; }
  .menu-item-image { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; }
  .menu-item-body { padding: var(--space-4); flex: 1; display: flex; flex-direction: column; gap: var(--space-2); }
  .menu-item-header { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); }
  .menu-item-name { font-size: var(--fs-h3); margin: 0; color: var(--color-text); }
  .menu-item-price { font-family: Georgia, 'Times New Roman', serif; font-weight: 700; color: var(--color-accent); white-space: nowrap; }
  .menu-item-description { margin: 0; font-size: var(--fs-small); color: var(--color-text-muted); font-style: italic; }
  .menu-item--dogs { border-left: 4px solid var(--color-accent-alt); }
  .menu-item--plates { border: 1px solid var(--color-charcoal-700); }
  .menu-item--sides .menu-item-name { font-size: var(--fs-h4); }
  .menu-item--drinks .menu-item-image { aspect-ratio: 4 / 3; }
  .menu-item--bakery { background: var(--color-bg-alt, var(--color-surface)); }
  .menu-item--dessert { border-top: 3px solid var(--color-accent-alt); }
  .menu-item--dessert .menu-item-name { font-style: italic; }

  /* Add-to-order button. Default: gold circle "+". In cart: gold pill with a
   * cart glyph + the quantity of this item — an obvious "it's in your order" cue. */
  .add-btn {
    margin-inline-start: auto;
    min-inline-size: 2rem;
    block-size: 2rem;
    padding-inline: 0;
    border: none;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-charcoal-900);          /* dark text on gold = crisp */
    font-size: 1.25rem;
    line-height: 1;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    transition: transform 120ms ease, background-color 120ms ease, box-shadow 120ms ease;
  }
  .add-btn:hover { filter: brightness(0.96); }
  .add-btn:active { transform: scale(0.94); }
  .add-btn svg { width: 1.05rem; height: 1.05rem; display: block; }

  .add-btn.is-in-cart {
    padding-inline: 0.6rem;                     /* expand into a pill */
    background: var(--color-mustard-400);       /* brighter gold so the change reads */
    box-shadow: 0 0 0 1px var(--color-mustard-600) inset;
  }
  .add-btn__count { font-family: var(--font-body); font-size: 0.95rem; font-weight: 800; }

  .add-btn.pop { animation: addpop 200ms ease; }
  @keyframes addpop {
    0% { transform: scale(1); }
    45% { transform: scale(1.22); }
    100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .add-btn.pop { animation: none; }
  }
</style>
