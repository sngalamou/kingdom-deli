---
// @ngc/ui/components/MenuItem
//
// Card for a single menu item. Slot named "badge" is for client-side badges
// (e.g. Kingdom Deli's NoPorkBadge). Image rendering is a placeholder until
// Sanity image-url helper is wired into the consumer.

interface MenuItemImage {
  asset?: unknown;
  alt?: string;
  url?: string;
}

interface MenuItemData {
  name: string;
  description?: string;
  price?: number;
  image?: MenuItemImage;
}

interface Props {
  item: MenuItemData;
}

const { item } = Astro.props;
const hasImage = Boolean(item.image?.url);
---

<article class="menu-item">
  <div class="menu-item-image">
    {hasImage ? (
      <img src={item.image?.url} alt={item.image?.alt ?? item.name} loading="lazy" />
    ) : (
      <div class="image-placeholder" aria-hidden="true" />
    )}
  </div>
  <div class="menu-item-body">
    <header class="menu-item-header">
      <h3>{item.name}</h3>
      {item.price !== undefined && (
        <span class="price">${item.price.toFixed(2)}</span>
      )}
    </header>
    {item.description && <p class="description">{item.description}</p>}
    <div class="menu-item-badge">
      <slot name="badge" />
    </div>
  </div>
</article>

<style>
  .menu-item {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg);
    border: var(--border-rule);
  }
  .menu-item-image {
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
    overflow: hidden;
  }
  .menu-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .image-placeholder {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      45deg,
      var(--color-surface),
      var(--color-surface) 8px,
      var(--color-bg) 8px,
      var(--color-bg) 16px
    );
  }
  .menu-item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }
  h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    margin: 0;
    color: var(--color-text);
  }
  .price {
    font-family: var(--font-display);
    color: var(--color-accent-alt);
    font-size: var(--fs-h3);
    white-space: nowrap;
  }
  .description {
    font-family: var(--font-body);
    color: var(--color-text-muted);
    margin: 0;
    font-size: var(--fs-small);
    line-height: var(--lh-base);
  }
  .menu-item-badge:empty { display: none; }
</style>
