---
// Order — Kingdom Deli pickup ordering via Square Online.
import BaseLayout from '@ngc/ui/layouts/BaseLayout.astro';
import { SquareOrderEmbed } from '@ngc/square';
---

<BaseLayout title="Order pickup — Kingdom Deli">
  <header class="order-header">
    <h1>Order for pickup</h1>
    <p>
      {/* TODO: Brief copy — "We're in the Louis Joliet Mall food court. Come in through Cinemark." */}
    </p>
  </header>

  <SquareOrderEmbed
    locationId={import.meta.env.PUBLIC_SQUARE_LOCATION_ID}
    mode="pickup"
  />

  <section class="order-footer">
    {/* TODO: Below-fold content — hours, what to expect, how pickup works at the food court counter. */}
  </section>
</BaseLayout>
