//   *[_type == "menuCategory"] | order(displayOrder asc) {
//     _id,
//     name,
//     displayOrder,
//     "items": *[_type == "menuItem" && references(^._id) && available == true] | order(name asc) {
//       _id, name, description, price, noPork, squareSku, image
//     }
//   }
// `);
---

<BaseLayout title="Menu — Kingdom Deli">
  <header class="menu-header">
    <h1>The menu</h1>
    <p>
      {/* TODO: Voice-driven menu intro. Reference the "No pork on my fork" badge legend. */}
    </p>
    <p class="menu-legend">
      <NoPorkBadge size="sm" /> &mdash; this item is on the all-beef line.
    </p>
  </header>

  {/* TODO: Render each category with items.
      <NoPorkBadge /> renders only when item.noPork === true.

      {categories.map((cat) => (
        <section class="menu-category">
          <h2>{cat.name}</h2>
          <div class="menu-grid">
            {cat.items.map((item) => (
              <MenuItem item={item}>
                {item.noPork && <NoPorkBadge slot="badge" />}
              </MenuItem>
            ))}
          </div>
        </section>
      ))}
  */}
</BaseLayout>
