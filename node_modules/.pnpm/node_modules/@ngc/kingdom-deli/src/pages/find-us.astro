---
// Find Us — Mall address + Cinemark-entrance wayfinding + hours + embedded map.
import BaseLayout from '@ngc/ui/layouts/BaseLayout.astro';
import HoursBlock from '@ngc/ui/components/HoursBlock.astro';
import WayfindingCard from '../components/WayfindingCard.astro';
---

<BaseLayout title="Find us — Louis Joliet Mall food court">
  <header class="find-header">
    <h1>Find us</h1>
    <p>Louis Joliet Mall food court &middot; 3340 Mall Loop Dr, Joliet, IL 60431</p>
  </header>

  <WayfindingCard />

  <section class="find-hours">
    <h2>Hours</h2>
    <HoursBlock />
  </section>

  {/* Embedded Google Maps. Free, no API key. Mapbox would look better but adds cost
      and a token-management surface — not worth it at low-mid budget for V1. */}
  <section class="find-map">
    <iframe
      title="Louis Joliet Mall map"
      src="https://www.google.com/maps?q=3340+Mall+Loop+Dr,+Joliet,+IL+60431&output=embed"
      width="100%"
      height="400"
      loading="lazy"
      style="border: 0;"
      allowfullscreen
    ></iframe>
  </section>
</BaseLayout>
