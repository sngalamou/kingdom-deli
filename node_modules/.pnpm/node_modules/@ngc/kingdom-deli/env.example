# Kingdom Deli — Environment Variables
# Copy to .env.local for development. Production values managed via Cloudflare Pages dashboard.

# === Sanity ===
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_READ_TOKEN=          # Read-only, optional — only needed for preview / private content

# === Square ===
# Sandbox values for local dev. Production values go in CF Pages dashboard, not here.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox  # 'sandbox' | 'production'
PUBLIC_SQUARE_APPLICATION_ID=
PUBLIC_SQUARE_LOCATION_ID=

# === Forms ===
PUBLIC_CONTACT_FORM_ENDPOINT=

# === Analytics ===
PUBLIC_PLAUSIBLE_DOMAIN=    # Or whatever the @ngc/config default analytics is
