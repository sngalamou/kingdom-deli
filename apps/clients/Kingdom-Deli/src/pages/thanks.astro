---
// /order/thanks — post-checkout confirmation. Square redirects here after payment.
import BaseLayout from '@ngc/ui/layouts/BaseLayout.astro';
import site from '../../content/site.json';
---
<BaseLayout
  title="Order received — Kingdom Deli"
  description="Your Kingdom Deli pickup order is in. Come find us at the counter."
  brand={site.brand}
  footerTagline={site.footerTagline}
>
  <section class="section thanks">
    <p class="thanks-kicker">Payment received</p>
    <h1 class="thanks-title">You're all set.</h1>
    <p class="thanks-lede">
      Thanks for ordering. We've got it — come to the counter and we'll have it ready.
    </p>

    <p class="thanks-ref" id="order-ref" hidden>
      Order reference: <span id="order-ref-value"></span>
    </p>

    <div class="thanks-pickup">
      <h2>Picking up</h2>
      <p>We're in the Louis Joliet Mall food court — come in through Cinemark.</p>
      <p>Show your name or order reference at the counter.</p>
    </div>

    <div class="cta-pair">
      <a href="/menu" class="cta-secondary">Back to menu</a>
      <a href="/" class="cta-primary">Home</a>
    </div>
  </section>

  <script>
    // Square appends params (orderId / transactionId) to the redirect. Show one if present.
    const p = new URLSearchParams(window.location.search);
    const ref = p.get('orderId') || p.get('transactionId') || p.get('checkoutId');
    if (ref) {
      document.getElementById('order-ref-value').textContent = ref;
      document.getElementById('order-ref').hidden = false;
    }
  </script>

  <style>
    .thanks { max-width: 40rem; margin-inline: auto; text-align: center; }
    .thanks-kicker {
      text-transform: uppercase; letter-spacing: 0.08em;
      font-size: 0.85rem; font-weight: 700; opacity: 0.7; margin: 0 0 0.5rem;
    }
    .thanks-title { margin: 0 0 0.75rem; }
    .thanks-lede { font-size: 1.15rem; line-height: 1.5; margin: 0 auto 1.5rem; }
    .thanks-ref {
      font-size: 0.95rem; opacity: 0.8;
      padding: 0.5rem 0.75rem; border: 1px solid currentColor; border-radius: 0.5rem;
      display: inline-block; margin-bottom: 1.75rem; word-break: break-all;
    }
    .thanks-pickup { text-align: left; margin: 0 auto 2rem; max-width: 30rem; }
    .thanks-pickup h2 { margin: 0 0 0.5rem; }
    .thanks-pickup p { margin: 0 0 0.4rem; }
    .cta-pair { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  </style>
</BaseLayout>