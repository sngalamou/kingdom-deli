---
// Menu — Kingdom Deli
// Renders all menu items grouped by category, ordered by category.displayOrder.
// NoPorkBadge appears only when item.noPork === true.
//
// Data source: local JSON files in src/content/menu/. When Sanity lands,
// swap src/lib/menu.ts to query Sanity — this page doesn't change.
import BaseLayout from '@ngc/ui/layouts/BaseLayout.astro';
import '../styles/tokens.css';
import MenuItem from '@ngc/ui/components/MenuItem.astro';
import NoPorkBadge from '../components/NoPorkBadge.astro';
import { getMenu } from '../lib/menu';
import site from '../content/site.json';

const categories = getMenu();
---

<BaseLayout title="Menu — Kingdom Deli" brand={site.brand} footerTagline={site.footerTagline}>
  <article class="menu-page">
    <header class="menu-header">
      <h1>The menu</h1>
      <p class="menu-intro">
        Short menu, made fresh. Old-school Chicago deli classics, the Vienna Beef
        line done right, jerk chicken from the islands, and a bakery counter built
        around the Chicago Lunchroom Butter Cookie.
      </p>
      <p class="menu-legend">
        <NoPorkBadge size="sm" /> <span>{site.noPorkExplainer}</span>
      </p>
    </header>

    {categories.map((cat) => (
      <section class="menu-category" id={cat.slug}>
        <header class="category-header">
          <h2>{cat.name}</h2>
          {cat.description && <p>{cat.description}</p>}
        </header>
        <div class="menu-grid">
          {cat.items.map((item) => (
            <MenuItem item={{ name: item.name, description: item.description, price: item.price }}>
              {item.noPork && <NoPorkBadge slot="badge" />}
            </MenuItem>
          ))}
        </div>
      </section>
    ))}

    <footer class="menu-footer">
      <p>
        Menu and prices subject to change. Allergies or dietary questions? Ask
        at the counter and we'll walk through it with you.
      </p>
    </footer>
  </article>
</BaseLayout>

<style>
  .menu-page {
    max-width: 80rem;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-16);
  }
  .menu-header { margin-bottom: var(--space-12); }
  .menu-header h1 {
    font-size: var(--fs-display-2);
    margin: 0 0 var(--space-4);
  }
  .menu-intro {
    font-size: var(--fs-lead);
    max-width: 44rem;
    color: var(--color-text);
    margin: 0 0 var(--space-6);
  }
  .menu-legend {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-alt, var(--color-surface));
    border-left: 3px solid var(--color-accent-alt);
  }
  .menu-category { margin: var(--space-16) 0; }
  .category-header {
    border-bottom: var(--border-heavy);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .category-header h2 {
    font-size: var(--fs-h1);
    margin: 0;
    color: var(--color-text);
  }
  .category-header p {
    margin: var(--space-2) 0 0;
    font-style: italic;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-4);
  }
  .menu-footer {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: var(--border-rule);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
