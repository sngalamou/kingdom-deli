---
// Find Us — address + entrance wayfinding + hours + map.
// All data sourced from src/content/location.json.
import BaseLayout from '@ngc/ui/layouts/BaseLayout.astro';
import '../styles/tokens.css';
import HoursBlock from '@ngc/ui/components/HoursBlock.astro';
import WayfindingCard from '../components/WayfindingCard.astro';
import site from '../content/site.json';
import location from '../content/location.json';

const { address } = location;
const formattedAddress = `${address.street}, ${address.city}, ${address.state} ${address.postalCode}`;
---

<BaseLayout
  title={`Find us — ${location.parentVenue} food court`}
  description={`${site.brand} is in the ${location.parentVenue} food court. ${location.entranceNote}`}
  brand={site.brand}
  footerTagline={site.footerTagline}
>
  <article class="find-us-page">
    <header class="find-header">
      <h1>Find us</h1>
      <p class="find-address">
        {location.parentVenue} food court &middot; {formattedAddress}
      </p>
      <p class="find-lede">{location.entranceNote}</p>
    </header>

    <WayfindingCard />

    <section class="find-parking">
      <h2>Parking</h2>
      <p>
        Free, plenty of it. The mall lot has around {location.parking.spaces.toLocaleString()} spaces &mdash;
        {location.parking.notes}
      </p>
    </section>

    <section class="find-hours">
      <h2>Hours</h2>
      <HoursBlock hours={location.hours} />
    </section>

    <section class="find-map">
      <h2>On the map</h2>
      {/* Embedded Google Maps. Free, no API key. Mapbox would look better but adds cost
          and a token-management surface — not worth it at low-mid budget for V1. */}
      <iframe
        title={`${location.parentVenue} map`}
        src={location.mapEmbedUrl}
        width="100%"
        height="400"
        loading="lazy"
        style="border: 0;"
        allowfullscreen
      ></iframe>
      <p class="find-map-link">
        <a href={location.mapUrl} target="_blank" rel="noopener">Open in Google Maps &rarr;</a>
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .find-us-page {
    max-width: 60rem;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-16);
  }
  .find-header { margin-bottom: var(--space-12); }
  .find-header h1 {
    font-size: var(--fs-display-2);
    margin: 0 0 var(--space-3);
  }
  .find-address {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--color-text);
    margin: 0 0 var(--space-4);
  }
  .find-lede {
    font-size: var(--fs-lead);
    color: var(--color-text);
    max-width: 38rem;
    line-height: var(--lh-snug);
    margin: 0;
  }
  .find-parking,
  .find-hours,
  .find-map {
    margin: var(--space-12) 0;
  }
  .find-parking h2,
  .find-hours h2,
  .find-map h2 {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-heavy);
  }
  .find-parking p {
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    max-width: 38rem;
    margin: 0;
  }
  .find-map-link {
    text-align: right;
    font-size: var(--fs-small);
    margin: var(--space-2) 0 0;
  }
  .find-map-link a {
    color: var(--color-accent-alt);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: var(--tracking-uppercase);
  }
  .find-map-link a:hover { text-decoration: underline; }
</style>
