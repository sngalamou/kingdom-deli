---
// About — Maxwell Street heritage, "wholistic, good food," family story.
import BaseLayout from '@ngc/ui/layouts/BaseLayout.astro';
import '../styles/tokens.css';
import site from '../content/site.json';
---

<BaseLayout title="About — Kingdom Deli" brand={site.brand} footerTagline={site.footerTagline}>
  <article class="about">
    <h1>The story</h1>

    <section class="about-story">
      {/* HENRY — your voice goes here.
          Send 2–3 paragraphs (or voice notes, or bullet points) on:
          1. Why you started Kingdom Deli — one specific reason, not a list
          2. A Maxwell Street memory (yours or family's) that connects to
             what you're doing now
          3. What "wholistic, good food" means to you in plain words
          4. What "Kingdom" means in the name
          We'll shape it from there. */}
      <div class="about-placeholder">
        <p class="placeholder-label">Henry — your story goes here.</p>
        <p>Send a few paragraphs, voice notes, or bullets on:</p>
        <ol>
          <li>Why you started Kingdom Deli — one specific reason, not a list</li>
          <li>A Maxwell Street memory that connects to what you're doing now</li>
          <li>What "wholistic, good food" means in plain words</li>
          <li>What "Kingdom" means in the name</li>
        </ol>
        <p>We'll shape it from there.</p>
      </div>
    </section>

    <section class="about-no-pork">
      <h2>About "No pork on my fork"</h2>
      <p>
        A lot of people in our community don't eat pork — for faith, for
        health, or just because that's how they were raised. We wanted to be
        honest about which items we serve are part of the all-beef line,
        instead of making people ask.
      </p>
      <p>
        So you'll see a small stamp on those items: Vienna Beef hot dogs and
        Polish, our corned beef and pastrami. It's a product promise, item by
        item — not a slogan painted across the whole place. If we ever serve
        something with pork, we'll tell you that straight too.
      </p>
    </section>
  </article>
</BaseLayout>
<script>
  import { initAddButtons } from '../lib/cart';
  initAddButtons();
</script>