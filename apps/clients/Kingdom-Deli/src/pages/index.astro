---
// Home — Kingdom Deli
//
// All copy lives in src/content/site.json. All location info in
// src/content/location.json. Featured menu items come from the menu loader.
// When Sanity is provisioned, only the data sources change — this template
// stays the same.
import BaseLayout from '@ngc/ui/layouts/BaseLayout.astro';
import '../styles/tokens.css';
import Hero from '@ngc/ui/components/Hero.astro';
import HoursBlock from '@ngc/ui/components/HoursBlock.astro';
import MenuItem from '@ngc/ui/components/MenuItem.astro';
import NoPorkBadge from '../components/NoPorkBadge.astro';
import WayfindingCard from '../components/WayfindingCard.astro';
import site from '../content/site.json';
import location from '../content/location.json';
import { getFeaturedItems } from '../lib/menu';

const featured = getFeaturedItems();
const pageTitle = `${site.brand} — ${site.tagline} ${location.parentVenue}.`;
---

<BaseLayout
  title={pageTitle}
  description={site.subTagline}
  brand={site.brand}
  footerTagline={site.footerTagline}
>
  <Hero>
    <h1 slot="headline">{site.tagline}</h1>
    <p slot="subhead">{site.subTagline}</p>
    <a slot="cta-primary" href="/order">{site.ctaCopy.orderPrimary}</a>
    <a slot="cta-secondary" href="/menu">{site.ctaCopy.orderSecondary}</a>
	<section class="hero">
	  <img
		src="/images/hero/home-hero.jpg"
		alt="Pastrami sandwich on rye, hand-cut and stacked high"
		width="2400"
		height="1600"
		class="hero-image"
	  />
	  <div class="hero-overlay">
		<h1>{site.tagline}</h1>
		<!-- ... -->
	  </div>
	</section>
  </Hero>

  {featured.length > 0 && (
    <section class="section section--featured">
      <header class="section-header">
        <h2>What we're known for</h2>
        <p class="section-lede">A short list. Built to last.</p>
      </header>
      <div class="featured-grid">
        {featured.map((item) => (
          <MenuItem item={{ name: item.name, description: item.description, price: item.price }}>
            {item.noPork && <NoPorkBadge slot="badge" />}
          </MenuItem>
        ))}
      </div>
    </section>
  )}

  <section class="section section--brand">
    <h2>Small on purpose.</h2>
    <p>
      One counter, a short menu of things we believe in. Vienna Beef done right.
      Hand-built deli sandwiches. Jerk chicken from the islands. A bakery case
      anchored by the Chicago Lunchroom Butter Cookie.
    </p>
    <p>
      Look for the <em>No pork on my fork</em> stamp on the all-beef line.
      That's a product promise, not a slogan.
    </p>
  </section>

  <section class="section section--location">
    <HoursBlock hours={location.hours} />
    <WayfindingCard />
  </section>

  <section class="section section--cta">
    <h2>Two ways in.</h2>
    <p>Order ahead for pickup, or come find us at the counter.</p>
    <div class="cta-pair">
      <a href="/order" class="cta-primary">{site.ctaCopy.orderPrimary}</a>
      <a href="/find-us" class="cta-secondary">Find us</a>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6);
  }
  .section-header { margin-bottom: var(--space-8); }
  .section h2 {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    margin: 0 0 var(--space-3);
    color: var(--color-text);
  }
  .section-lede {
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0;
  }
  .section p {
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    max-width: 40rem;
    color: var(--color-text);
  }

  .section--featured {
    border-bottom: var(--border-rule);
  }
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-4);
  }

  .section--brand {
    background: var(--color-bg-alt, var(--color-surface));
    max-width: none;
    border-bottom: var(--border-rule);
  }
  .section--brand > * { max-width: 72rem; margin-left: auto; margin-right: auto; }
  .section--brand em {
    font-style: normal;
    color: var(--color-accent-alt);
    font-family: var(--font-display);
    font-size: 0.95em;
  }

  .section--location {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
    border-bottom: var(--border-rule);
  }
  @media (max-width: 720px) {
    .section--location { grid-template-columns: 1fr; }
  }

  .section--cta {
    text-align: center;
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }
  .section--cta h2 {
    font-size: var(--fs-display-2);
    margin-bottom: var(--space-3);
  }
  .section--cta p {
    margin: 0 auto var(--space-8);
    font-size: var(--fs-lead);
  }
  .cta-pair {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .cta-primary,
  .cta-secondary {
    font-family: var(--font-display);
    padding: var(--space-3) var(--space-8);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: var(--tracking-uppercase);
    border: var(--border-heavy);
    transition: transform 150ms ease;
  }
  .cta-primary {
    background: var(--color-accent);
    color: var(--color-charcoal-900);
  }
  .cta-primary:hover { transform: translateY(-1px); }
  .cta-secondary {
    background: transparent;
    color: var(--color-text);
  }
  .cta-secondary:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .hero-image {
    width: 100%;
    height: 60vh;
    object-fit: cover;
  }
</style>
