---
// DessertBadge — "Bakery Box Label": filled bright-gold sticker with dark text.
// Gold family (sweets), shared shade-sibling with Desert.
interface Props {
  /** Override default label (e.g., for a menu legend). Defaults to the category name. */
  label?: string;
  /** Visual size. Default 'sm' for in-card placement. */
  size?: 'sm' | 'md';
}
const { label = 'Dessert', size = 'sm' } = Astro.props;
---

<span class={`dessert-badge dessert-badge--${size}`} role="img" aria-label={label} title={label}>
  <span class="dessert-badge__inner">{label}</span>
</span>

<style>
  /* Bakery box label: filled bright gold, rounded sticker corners, dark text. */
  .dessert-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-charcoal-900, #1a1611);
    background: var(--color-mustard-400, #e8b837);
    border: 1.5px solid var(--color-mustard-500, #d4a017);
    border-radius: 8px;
    padding: 0.25em 0.55em 0.2em;
    line-height: 1;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .dessert-badge:hover {
    transform: translateY(-2px);
    box-shadow: 3px 3px 0 var(--color-mustard-600, #b07c08);
  }
  .dessert-badge--sm { font-size: 0.6875rem; }
  .dessert-badge--md { font-size: 0.875rem; padding: 0.35em 0.75em 0.3em; }
  .dessert-badge__inner { display: inline-block; }
</style>
