---
// Desert — pale-gold stamp variant. Gold family (sweets); shade-sibling of
// DessertBadge, kept distinct with a paler gold and a stamp rotation.
interface Props {
  /** Override default label (e.g., for a menu legend). Defaults to the tagline. */
  label?: string;
  /** Visual size. Default 'sm' for in-card placement. */
  size?: 'sm' | 'md';
}
const { label = 'Desert', size = 'sm' } = Astro.props;
---

<span class={`desert desert--${size}`} role="img" aria-label={label} title={label}>
  <span class="desert__inner">{label}</span>
</span>

<style>
  /* Pale-gold stamp: filled, slight rotation — a softer sweet-counter mark. */
  .desert {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-charcoal-900, #1a1611);
    background: var(--color-mustard-300, #f3d27e);
    border: 1.5px solid var(--color-mustard-500, #d4a017);
    border-radius: 2px;
    padding: 0.25em 0.55em 0.2em;
    transform: rotate(-3deg);
    line-height: 1;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .desert:hover {
    transform: translateY(-2px) rotate(-3deg);
    box-shadow: 3px 3px 0 var(--color-mustard-600, #b07c08);
  }
  .desert--sm { font-size: 0.6875rem; }
  .desert--md { font-size: 0.875rem; padding: 0.35em 0.75em 0.3em; }
  .desert__inner { display: inline-block; }
</style>
