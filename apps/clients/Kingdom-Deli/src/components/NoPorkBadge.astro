---
// NoPorkBadge — Henry's "No pork on my fork" as a gold inspection seal.
// Filled primary gold so it reads as a distinct stamp, not a category color.
// See ADR 0003.
interface Props {
  /** Override default label (e.g., for a menu legend). Defaults to the tagline. */
  label?: string;
  /** Visual size. Default 'sm' for in-card placement. */
  size?: 'sm' | 'md';
}
const { label = 'No pork on my fork', size = 'sm' } = Astro.props;
---

<span class={`no-pork-badge no-pork-badge--${size}`} role="img" aria-label={label} title={label}>
  <span class="no-pork-badge__inner">{label}</span>
</span>

<style>
  /* Gold inspection seal: filled primary gold, slight rotation, dark text.
   * Sits on the all-beef items as a distinct stamp over the meat badges. */
  .no-pork-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-charcoal-900, #1a1611);
    background: var(--color-mustard-500, #d4a017);
    border: 1.5px solid var(--color-mustard-600, #b07c08);
    border-radius: 2px;
    padding: 0.25em 0.55em 0.2em;
    transform: rotate(-3deg);
    line-height: 1;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .no-pork-badge:hover {
    transform: rotate(-1deg) scale(1.02);
    box-shadow: 3px 3px 0 var(--color-mustard-600, #b07c08);
  }
  .no-pork-badge--sm { font-size: 0.6875rem; }
  .no-pork-badge--md { font-size: 0.875rem; padding: 0.35em 0.75em 0.3em; }
  .no-pork-badge__inner { display: inline-block; }
</style>
