---
// DrinksBadge — "Cold Bev": filled relish-green skewed chip with dark text.
// The lone green in the set — reads as refreshing, distinct from the food families.
interface Props {
  /** Override default label (e.g., for a menu legend). Defaults to the category name. */
  label?: string;
  /** Visual size. Default 'sm' for in-card placement. */
  size?: 'sm' | 'md';
}
const { label = 'Drinks', size = 'sm' } = Astro.props;
---

<span class={`drinks-badge drinks-badge--${size}`} role="img" aria-label={label} title={label}>
  <span class="drinks-badge__inner">{label}</span>
</span>

<style>
  /* Cold bev: crisp relish green, skewed for a little fizz. */
  .drinks-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-charcoal-900, #1a1611);
    background: var(--color-relish-500, #6aa345);
    border: 1.5px solid var(--color-relish-500, #6aa345);
    padding: 0.25em 0.55em 0.2em;
    transform: skewX(-10deg);
    line-height: 1;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .drinks-badge:hover {
    transform: translateY(-2px) skewX(-10deg);
    box-shadow: 3px 3px 0 var(--color-charcoal-900, #1a1611);
  }
  .drinks-badge--sm { font-size: 0.6875rem; }
  .drinks-badge--md { font-size: 0.875rem; padding: 0.35em 0.75em 0.3em; }
  /* un-skew the text so it stays readable */
  .drinks-badge__inner { display: inline-block; transform: skewX(10deg); }
</style>
