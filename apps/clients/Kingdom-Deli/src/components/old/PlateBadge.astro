---
// PlateBadge — The "Heavy Dinner" aesthetic for substantial meals.
// Matches the interface structure of existing badges.

interface Props {
  /** Override default label (e.g., for a menu legend). Defaults to the category name. */
  label?: string;
  /** Visual size. Default 'sm' for in-card placement. */
  size?: 'sm' | 'md';
}

const { label = 'Plate', size = 'sm' } = Astro.props;
---

<span
  class={`plate-badge plate-badge--${size}`}
  role="img"
  aria-label={label}
  title={label}
>
  <span class="plate-badge__inner">{label}</span>
</span>

<style>
  /* "Heavy Dinner" aesthetic: Solid Navy, sharp square corners, grounded drop shadow */
  .plate-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff; /* Brand White */
    background: #000080; /* Brand Navy */
    border-radius: 0; /* Sharp, square corners */
    padding: 0.25em 0.55em 0.2em;
    line-height: 1;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .plate-badge:hover {
    transform: translateY(-2px);
    /* Sharp drop shadow using Brand Charcoal */
    box-shadow: 4px 4px 0 #36454F; 
  }

  .plate-badge--sm {
    font-size: 0.6875rem; /* ~11px */
  }

  .plate-badge--md {
    font-size: 0.875rem;
    padding: 0.35em 0.75em 0.3em;
  }

  .plate-badge__inner {
    display: inline-block;
  }
</style>