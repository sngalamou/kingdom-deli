---
// DrinksBadge — "The 'Cold Bev'" aesthetic.
// Used on menuItem cards to denote refreshing drinks.

interface Props {
  /** Override default label (e.g., for a menu legend). Defaults to the tagline. [cite: 3] */
  label?: string;
  /** Visual size. Default 'sm' for in-card placement. [cite: 4] */
  size?: 'sm' | 'md';
}

const { label = 'Drinks', size = 'sm' } = Astro.props; 
---

<span
  class={`drinks-badge drinks-badge--${size}`}
  role="img"
  aria-label={label}
  title={label}
>
  <span class="drinks-badge__inner">{label}</span>
</span>

<style>
  /* "Cold Bev" aesthetic: crisp, refreshing, skewed layout */
  .drinks-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #000080; /* Navy */
    background: var(--color-cream-50, #fdfaf3);
    border: 1.5px solid #000080; /* Electric Blue */
    padding: 0.25em 0.55em 0.2em;
    transform: skewX(-10deg);
    box-shadow: 0 1px 0 rgba(0, 0, 128, 0.1);
    line-height: 1;
    transition: transform 200ms ease;
  }

  .drinks-badge:hover {
    transform: translateY(-2px);
    /* Sharp drop shadow using Brand Charcoal */
    box-shadow: 4px 4px 0 #36454F; 
  }
  .drinks-badge--sm {
    font-size: 0.6875rem; /* ~11px */
  }

  .drinks-badge--md {
    font-size: 0.875rem;
    padding: 0.35em 0.75em 0.3em;
  }

  /* Reversing the skew on the text so it remains perfectly readable */
  .drinks-badge__inner {
    display: inline-block;
    transform: skewX(10deg);
  }
</style>