---
// PlateBadge — "Heavy Dinner": solid deep-red square with cream text.
// Crimson family (meats); the grounded, substantial member.
interface Props {
  /** Override default label (e.g., for a menu legend). Defaults to the category name. */
  label?: string;
  /** Visual size. Default 'sm' for in-card placement. */
  size?: 'sm' | 'md';
}
const { label = 'Plate', size = 'sm' } = Astro.props;
---

<span class={`plate-badge plate-badge--${size}`} role="img" aria-label={label} title={label}>
  <span class="plate-badge__inner">{label}</span>
</span>

<style>
  /* Heavy dinner: solid deep-red, sharp square corners — grounded and filling. */
  .plate-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-cream-100, #f7f1de);
    background: var(--color-meatred-600, #9c0c22);
    border-radius: 0;
    padding: 0.25em 0.55em 0.2em;
    line-height: 1;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .plate-badge:hover {
    transform: translateY(-2px);
    box-shadow: 3px 3px 0 var(--color-charcoal-900, #1a1611);
  }
  .plate-badge--sm { font-size: 0.6875rem; }
  .plate-badge--md { font-size: 0.875rem; padding: 0.35em 0.75em 0.3em; }
  .plate-badge__inner { display: inline-block; }
</style>
