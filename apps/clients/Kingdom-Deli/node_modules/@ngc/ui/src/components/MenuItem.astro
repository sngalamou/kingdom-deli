---
// @ngc/ui/components/MenuItem
//
// Card for a single menu item. Slot named "badge" is for client-side badges
// (e.g. Kingdom Deli's NoPorkBadge). Image rendering is a placeholder until
// Sanity image-url helper is wired into the consumer.

interface MenuItemImage {
  asset?: unknown;
  alt?: string;
  url?: string;
}

interface MenuItemData {
  name: string;
  description?: string;
  price?: number;
  image?: MenuItemImage;
  // Added these to support your variantClass logic
  category?: string; 
  Desert?: boolean; 
}

interface Props {
  item: MenuItemData;
}

const { item } = Astro.props;

// 1. Determine if we have a valid image URL to render
const hasImage = !!item.image?.url;

// 2. Build the dynamic class string
// Pro-tip: .toLowerCase() ensures your CSS classes are always safe (e.g., 'menu-item--deli')
const variantClass = [
  'menu-item',
  item.category ? `menu-item--${item.category.toLowerCase()}` : null,
  item.Desert ? 'menu-item--desert' : null,
].filter(Boolean).join(' ');
--- 

<article class={variantClass}>
  <div class="menu-item-image">
    {hasImage ? (
      <img 
        src={item.image?.url} 
        alt={item.image?.alt ?? item.name} 
        loading="lazy" 
      />
    ) : (
      <div class="image-placeholder" aria-hidden="true" />
    )}
  </div>
  
  <div class="menu-item-body">
    <header class="menu-item-header">
      <h3 class="menu-item-name">{item.name}</h3>
      {item.price && <span class="menu-item-price">${item.price.toFixed(2)}</span>}
    </header>
    {item.description && <p class="menu-item-description">{item.description}</p>}
    
    <div class="flex gap-2 mt-3 items-center">
      <slot name="badge" />
    </div>
  </div>
</article>

<style>
  .menu-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .menu-item-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  .menu-item-body {
    padding: var(--space-4);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .menu-item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }

  .menu-item-name {
    font-size: var(--fs-h3);
    margin: 0;
    color: var(--color-text);
  }

  .menu-item-price {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .menu-item-description {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Per-category variants */

  .menu-item--deli {
    /* default styling — corned beef, pastrami, reuben, italian beef */
  }

  .menu-item--dogs {
    /* dogs get a subtle mustard-yellow left border */
    border-left: 4px solid var(--color-accent-alt);
  }

  .menu-item--plates {
    /* plates get slightly more visual weight */
    border: 1px solid var(--color-border);
  }

  .menu-item--sides .menu-item-name {
    /* sides get smaller titles — they're supporting */
    font-size: var(--fs-h4);
  }

  .menu-item--drinks {
    /* drinks compress vertically — they're less detailed */
  }

  .menu-item--drinks .menu-item-image {
    aspect-ratio: 4 / 3;
  }

  .menu-item--bakery {
    /* bakery gets a warm cream-tone background */
    background: var(--color-bg-alt, var(--color-surface));
  }

  /* Dessert flag adds an extra touch — only fires when isDessert: true */

  .menu-item--dessert {
    /* dessert items get a mustard accent border at the top */
    border-top: 3px solid var(--color-accent-alt);
  }

  .menu-item--dessert .menu-item-name {
    /* slightly fancier serif treatment for desserts */
    font-style: italic;
  }
</style>